rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // documente de descarcat, fundal, banner: citire publica, scriere doar utilizatori conectati (staff)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
    // documente semnate incarcate de participanti la inscriere (creare libera, citire/stergere doar conectati)
    match /uploads/{allPaths=**} {
      allow read, delete: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024;
    }
  }
}
